# Walnut Internal Brain: deployment env file. deploy.sh writes the real one to /opt/walnut/walnut.env
# (mode 600, outside the git checkout) with freshly generated values; this file is only a template.
# Generate each secret with:   openssl rand -hex 32
# NEVER put a real Slack, Atlassian or Google credential or workspace URL in here: the stack is synthetic
# data only and docker-compose.yml pins every platform to the in-stack mock.

# --- Local test only ---------------------------------------------------------------------------
# Image name prefix (two stacks on one Docker host) and the browser origin when Caddy listens on a
# non-standard port (e.g. DOMAIN=localhost, HTTPS_PORT=4243 -> IB_PUBLIC_ORIGIN=https://localhost:4243).
# Leave both unset on a server.
# WALNUT_IMAGE_PREFIX=walnut
# IB_PUBLIC_ORIGIN=

# --- TLS account -------------------------------------------------------------------------------
# Optional. The email for the Let's Encrypt / ZeroSSL account (default in docker-compose.yml).
# ACME_EMAIL=

# --- Public address ----------------------------------------------------------------------------
# Your domain (an A record pointing at the host), or <public-ip-with-dashes>.sslip.io (no DNS needed).
DOMAIN=203-0-113-10.sslip.io
# Host ports Caddy publishes. Keep 80/443 on a public host (Let's Encrypt needs both); change only for a local test.
HTTP_PORT=80
HTTPS_PORT=443

# --- Demo sign-in ------------------------------------------------------------------------------
# REQUIRED: the persona picker only works with this passcode. Share it only with the people who should sign in.
# (IB_DEMO_LOGIN=1 and IB_DEPLOYED=1 are fixed in docker-compose.yml and cannot be turned off here.)
IB_DEMO_PASSCODE=replace-with-openssl-rand-hex-8

# --- Internal Brain keys (>= 32 chars; IB_DEPLOYED=1 refuses the dev defaults) ------------------
# Changing IB_LEDGER_KEY after the first start makes the existing ledger unverifiable: reset the stack too.
IB_TOKEN_KEY=replace-with-openssl-rand-hex-32
IB_LEDGER_KEY=replace-with-openssl-rand-hex-32

# --- Mock platform secrets (shared by the mock and the Brain; never leave the host) -------------
# The two tokens must differ.
MOCK_SVC_TOKEN=replace-with-openssl-rand-hex-32
MOCK_ADMIN_TOKEN=replace-with-openssl-rand-hex-32
MOCK_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# --- AI model (optional) -----------------------------------------------------------------------
# Empty = deterministic answers quoted from the sources only (everything still works). To plug in a
# model, give any chat-completions-style JSON endpoint. Only permitted, released passages are ever sent.
#
# Example: Vultr Serverless Inference (OpenAI-compatible). Easiest on the VM:
#   sudo bash /opt/walnut/repo/deploy/docker/deploy.sh configure-model vultr
# which asks for the key with hidden input, lists the model ids your key may use, tests one, and restarts ib.
# By hand it is:
#   IB_MODEL_URL=https://api.vultrinference.com/v1
#   IB_MODEL_NAME=<a chat model id from `deploy.sh models`>
#   IB_MODEL_KEY=<your Vultr inference API key; only ever in /opt/walnut/walnut.env, mode 600>
#   IB_MODEL_FALLBACKS=<optional second chat model id>
IB_MODEL_URL=
IB_MODEL_NAME=
IB_MODEL_KEY=
# Comma-separated model names tried in order after IB_MODEL_NAME fails.
IB_MODEL_FALLBACKS=
# Optional spend and rate caps for model calls (empty = the built-in defaults).
IB_MODEL_CAP_USD=
IB_MODEL_DAILY_CAP_USD=
IB_MODEL_RPM=
IB_MODEL_USER_RPM=
# US$ per million input / output tokens (from your provider's price list), so the spend caps count.
IB_MODEL_PRICE_IN_USD=
IB_MODEL_PRICE_OUT_USD=
# Seconds to wait for a model answer before serving the quoted one (1-120; empty = 12).
IB_MODEL_ANSWER_TIMEOUT_S=
# Sent as reasoning.effort when set. Vultr's chat models all reason by default, and thinking counts against
# the token budget and the timeout above: `configure-model vultr` sets none.
IB_MODEL_REASONING_EFFORT=
# 1 = never call a model even if one is configured
IB_FORCE_OFFLINE=0

# --- Freshness and ledger anchoring (optional) ---------------------------------------------------
# Poll fallback for change events (seconds).
IB_POLL_S=120
# How often the ledger head is published to the anchor sink (seconds).
IB_ANCHOR_INTERVAL_S=900
# Path INSIDE the ib container for the external head file. Empty = /var/lib/ib/external_anchor/heads.jsonl,
# which is on the same host (not off-host). Point it at off-host storage for a real deployment.
IB_ANCHOR_FILE=
