# DataBridge — model configuration (optional).
# Copy this to `.env` and fill it in only if you want a model. (.env is git-ignored — never commit
# real keys.)
#
# One provider-neutral adapter: any chat-completions-style JSON endpoint (hosted, or a local
# server on your own network). The repo names no endpoint and no model.
# IB_MODEL_URL=https://your-endpoint.example/v1
# IB_MODEL_NAME=your-model-name
# IB_MODEL_KEY=
# Optional: more model names on the same endpoint, tried in order.
# IB_MODEL_FALLBACKS=

# With NO model configured, everything falls back to the deterministic path (airgapped CI/demo)
# and every grounded answer still works — it just isn't model-narrated (is_real_llm=false).
