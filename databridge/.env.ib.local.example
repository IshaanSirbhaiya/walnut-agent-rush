# Internal Brain: local settings and keys (template).
# Copy this file to `databridge/.env.ib.local` and fill in what you use. That file is git-ignored
# (`.env.*.local`) and read only by the Internal Brain process (scripts/demo_up.sh): the model
# settings reach only the Brain; the mock platforms, the seeder, the engine and the web app start
# without them.
# Never commit real keys. With no model configured, every answer is quoted from the sources.
#
# Which model answers, in this order:
#   1. the configured model (IB_MODEL_NAME on IB_MODEL_URL), then each IB_MODEL_FALLBACKS name;
#   2. otherwise the quoted answer, built from the cited sentences.
# Whichever answers, the model sees only passages that passed Gate 1 and the live Gate 2, and the
# grounding check runs on its text. IB_FORCE_OFFLINE=1 turns every model off.

# --- The model (optional; one provider-neutral adapter) -----------------------------------------
# Base URL of any chat-completions-style JSON endpoint (the adapter posts to <url>/chat/completions).
IB_MODEL_URL=
# The model name sent to it; also the model id answers show.
IB_MODEL_NAME=
# Bearer key, if the endpoint needs one. Never logged, never shown.
IB_MODEL_KEY=
# More model names on the same endpoint, comma-separated, tried in order after IB_MODEL_NAME.
# IB_MODEL_FALLBACKS=
# Seconds an answer may take before the quoted answer is served instead (1 to 120, default 12).
# IB_MODEL_ANSWER_TIMEOUT_S=12
# Model names (patterns) that reject a temperature setting; none by default.
# IB_MODEL_FIXED_SAMPLING=

# --- Guardrails (D-42), read at start-up only; no screen or API changes them --------------------
# Any limit hit = no model call. Prices (US$ per million tokens) are what the spend caps count;
# with no prices set, the caps count nothing and only the rates limit calls.
# IB_MODEL_PRICE_IN_USD=0
# IB_MODEL_PRICE_OUT_USD=0
# Total spend cap in US$ for every model call, kept in a ledger no demo reset clears (default 11).
# IB_MODEL_CAP_USD=11
# Spend cap per UTC day in US$ (default 5).
# IB_MODEL_DAILY_CAP_USD=5
# Model calls per minute for the whole service: answers, pages and rewrites together (default 20).
# IB_MODEL_RPM=20
# Model calls per person per minute (default 6).
# IB_MODEL_USER_RPM=6
# Where the spend ledger lives (default databridge/var/model_guard; keep it outside var/ib-final).
# IB_MODEL_GUARD_DIR=var/model_guard

# --- Switches -----------------------------------------------------------------------------------
# 1 = no model at all (deterministic quoted answers).
# IB_FORCE_OFFLINE=1
# Set by a launcher from a live check of the endpoint: anything but 1 = the model is not used.
# IB_MODEL_LIVE=
# Sign-in passcode for a public URL (empty = the local demo sign-in without a passcode).
# IB_DEMO_PASSCODE=
