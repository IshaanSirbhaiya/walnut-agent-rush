# secrets — never commit real API keys
.env
.env.local
.env.*.local
# session / bearer token files written by demo scripts (never committed)
*.tok

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.uv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / frontend
node_modules/
.next/
out/
build/
playwright-report/
test-results/
*.tsbuildinfo
next-env.d.ts

# Local workspace produced by the CLI (a demo is a zippable dir; not committed)
.databridge/

# Obsidian per-user workspace state (the vault IS the repo; workspace prefs are not)
.obsidian/workspace*
.obsidian/cache

# OS
.DS_Store
Thumbs.db

# scratch test-output files
*.log
/r.txt
/*.out.txt

# review scratch — the bundles fed to a reviewer are concatenations of tracked
# sources; the reviews themselves (.reviews/*.review.txt) ARE committed.
/.review-bundle.txt
/.review-output.txt
/.review-prompt.txt
/.reviews/*.txt
!/.reviews/*.review.txt

# Coding-agent per-machine state (on a fresh clone `git add -A` would sweep it in).
# Skills under .agents/skills/ may be tracked; local settings never are.
**/.agents/settings.local.json
**/.agents/settings.local.json.backup

# Coverage / build output
.coverage
.coverage.*
htmlcov/
coverage/
dist/
*.egg-info/

# Editor / OS junk
.idea/
.vscode/
*.swp
*~
ehthumbs.db
desktop.ini

# The outbox store the gateway and the dispatcher share. A runtime artefact, not source.
databridge/var/

# Generated OCR trial documents — rebuild with fixtures/clinic/ocr_samples/build.py.
# Same convention as packages/convert/tests/fixtures/chits: no binaries checked in.
databridge/fixtures/clinic/ocr_samples/*.png
databridge/fixtures/clinic/ocr_samples/*.pdf
# `__typed.txt` is generated by the same builder and was missed, so five files sat permanently
# untracked and showed up as uncommitted work in every session.
databridge/fixtures/clinic/ocr_samples/*__typed.txt
